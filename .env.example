SECRET_KEY=change-this-to-a-random-long-string
S3_BUCKET_NAME=your-unique-bucket-name-here
AWS_REGION=ap-south-1
FLASK_ENV=development
DATABASE_URI=sqlite:///../instance/app.db

# ONLY for local testing if you are not using `aws configure` /IAM role.
# Leave blank on EC2 - IAM Role will be used instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
